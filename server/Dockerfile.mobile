# Smartphone-Server „Prüfplanung mobil“ (siehe README, Abschnitt Smartphone-App)
FROM python:3.12-slim
WORKDIR /app
COPY requirements-mobile.txt .
RUN pip install --no-cache-dir -r requirements-mobile.txt
COPY erp ./erp
COPY erp_mobile ./erp_mobile
ENV PYTHONUNBUFFERED=1 TZ=Europe/Berlin
EXPOSE 8080
USER nobody
CMD ["python", "-m", "erp_mobile", "--port", "8080"]
